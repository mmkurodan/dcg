<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        android:id="@+id/resultStatusView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/resultHeadlineView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/textPrimary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/resultSummaryView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/textPrimary"
        android:textSize="13sp" />

    <Button
        android:id="@+id/resultCopyLogsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="12dp"
        android:text="@string/action_copy_logs"
        android:visibility="gone" />

    <TextView
        android:id="@+id/resultStdoutLabelView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/result_stdout_label"
        android:textColor="@color/textSecondary"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/resultStdoutView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:textColor="@color/textPrimary"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/resultReturnValueLabelView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/result_return_value_label"
        android:textColor="@color/textSecondary"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/resultReturnValueView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:textColor="@color/textPrimary"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/resultErrorLabelView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/result_error_label"
        android:textColor="@color/error"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/resultErrorView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:textColor="@color/textPrimary"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/resultDetailsLabelView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/result_details_label"
        android:textColor="@color/textSecondary"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/resultDetailsView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:textColor="@color/textPrimary"
        android:textSize="13sp"
        android:visibility="gone" />
</merge>
